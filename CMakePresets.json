{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_EXE_LINKER_FLAGS": "-Wl,-S",
				"CMAKE_EXPORT_COMPILE_COMMANDS": true
			},
			"environment": {
				"CCC_DEBUGGING_FLAGS": "-O2 -g0",
				"CCC_FIRST_PARTY_FLAGS": "-Wconversion -Wimplicit-fallthrough",
				"CCC_FORTIFY_FLAGS": "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3",
				"CCC_HARDENING_FLAGS": "",
				"CCC_MISCELLANEOUS_FLAGS": "-Wall -fdiagnostics-color=always",
				"CCC_SANITIZER_FLAGS": ""
			}
		},
		{
			"name": "enable-debugging",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_EXE_LINKER_FLAGS": ""
			},
			"environment": {
				"CCC_FORTIFY_FLAGS": "",
				"CCC_DEBUGGING_FLAGS": "-O0 -ggdb"
			}
		},
		{
			"name": "enable-hardening",
			"hidden": true,
			"environment": {
				"CCC_HARDENING_FLAGS": "-Wformat -Wformat=2 -D_GLIBCXX_ASSERTIONS -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST -fstrict-flex-arrays=3 -fstack-clash-protection -fstack-protector-strong -fno-delete-null-pointer-checks -fno-strict-overflow -ftrivial-auto-var-init=zero"
			}
		},
		{
			"name": "release",
			"inherits": ["enable-hardening", "base"],
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_C_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"CMAKE_CXX_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"FIRST_PARTY_FLAGS": "$env{CCC_FIRST_PARTY_FLAGS}"
			}
		},
		{
			"name": "release-unhardened",
			"inherits": ["base"],
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_C_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"CMAKE_CXX_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"FIRST_PARTY_FLAGS": "$env{CCC_FIRST_PARTY_FLAGS}"
			}
		},
		{
			"name": "debug",
			"inherits": ["enable-debugging", "enable-hardening", "base"],
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_C_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"CMAKE_CXX_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"FIRST_PARTY_FLAGS": "$env{CCC_FIRST_PARTY_FLAGS}",
				"ENABLE_FUZZ_TESTING": false,
				"BUILD_DEMANGLER_TOOLS": true
			}
		},
		{
			"name": "debug-unhardened",
			"inherits": ["enable-debugging", "base"],
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_C_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"CMAKE_CXX_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"FIRST_PARTY_FLAGS": "$env{CCC_FIRST_PARTY_FLAGS}",
				"ENABLE_FUZZ_TESTING": false,
				"BUILD_DEMANGLER_TOOLS": true
			}
		},
		{
			"name": "debug-fuzzer",
			"inherits": ["debug"],
			"cacheVariables": {
				"CMAKE_C_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"CMAKE_CXX_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"FIRST_PARTY_FLAGS": "$env{CCC_FIRST_PARTY_FLAGS}",
				"ENABLE_FUZZ_TESTING": true
			}
		},
		{
			"name": "debug-sanitize",
			"inherits": ["debug-fuzzer"],
			"cacheVariables": {
				"CMAKE_C_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"CMAKE_CXX_FLAGS": "$env{CCC_DEBUGGING_FLAGS} $env{CCC_FORTIFY_FLAGS} $env{CCC_HARDENING_FLAGS} $env{CCC_MISCELLANEOUS_FLAGS} $env{CCC_SANITIZER_FLAGS}",
				"FIRST_PARTY_FLAGS": "$env{CCC_FIRST_PARTY_FLAGS}"
			},
			"environment": {
				"CCC_SANITIZER_FLAGS": "-fsanitize=address,undefined"
			}
		}
	]
}
